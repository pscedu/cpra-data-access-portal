{
  "private": true,
  "name": "cpra-data-access-portal",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider preact build --no-sw --no-prerender",
    "serve": "sirv build --port 8080 --cors --single",
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider preact watch --no-sw",
    "lint": "eslint src",
    "test": "jest",
    "readme": "npx marked -i src/assets/metadata.md -o src/assets/metadata.html"
  },
  "eslintConfig": {
    "extends": "preact",
    "ignorePatterns": [
      "build/"
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "enzyme": "^3.11.0",
    "enzyme-adapter-preact-pure": "^4.0.0",
    "eslint": "^8.30.0",
    "eslint-config-preact": "^1.3.0",
    "jest": "^27.0.0",
    "jest-preset-preact": "^4.0.5",
    "marked": "^5.1.1",
    "preact-cli": "^3.4.2",
    "sass": "^1.57.1",
    "sass-loader": "^10.3.1",
    "sirv-cli": "^2.0.2"
  },
  "dependencies": {
    "@preact/signals": "^1.1.3",
    "bootstrap": "^5.2.3",
    "chart.js": "^4.3.0",
    "preact": "^10.11.3",
    "preact-render-to-string": "^5.2.6",
    "preact-router": "^3.2.1",
    "react-bootstrap": "^2.7.2"
  },
  "jest": {
    "preset": "jest-preset-preact",
    "setupFiles": [
      "<rootDir>/tests/__mocks__/browserMocks.js",
      "<rootDir>/tests/__mocks__/setupTests.js"
    ]
  }
}
